# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Plaid: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production  (switching to real accounts = production + production secret)
PLAID_ENV=sandbox

# 32 random bytes, base64:   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# >= 32 chars:               openssl rand -base64 48
SESSION_SECRET=

# Output of:                 npm run hash-password
DASHBOARD_PASSWORD_HASH=

# Optional; defaults to ./data/finance.db
# DATABASE_PATH=
